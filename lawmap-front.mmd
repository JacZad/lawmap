    %% --- Połączenia ---

    %% Konstytucja jako źródło
    konstytucja --> uzd
    konstytucja --> rtv
    konstytucja --> p_budowlane
    konstytucja --> k_cywilny
    konstytucja --> k_wyborczy
    konstytucja --> k_morski

    %% Prawo UE i jego transpozycja
    kpon --> uzd
    karta --> uzd
    ead --transpozycja--> udc
    eaa --transpozycja--> pad
    ue_loty --implementacja--> p_lotnicze

    %% Ustawa o dostępności cyfrowej (UDC)
    udc --delegacja--> warunki_dd
    udc --"norma techniczna"--> en301549

    %% Europejska ustawa o dostępności (PAD) - zmiany i odwołania
    pad --zmienia--> u_obszarymorskie
    pad --zmienia--> u_zeglugasrodladowa
    pad --zmienia--> u_transportdrogowy
    pad --zmienia--> p_lotnicze
    pad --zmienia--> u_transportkolejowy
    pad --zmienia--> u_platnicze
    pad --zmienia--> u_alarmowy
    pad --zmienia--> u_reklamacyjny
    pad --zmienia--> uzd
    pad --odwołanie--> kredyt
    pad --odwołanie--> hipoteczny
    pad --odwołanie--> instrumenty
    pad --odwołanie--> u_platnicze
    pad --odwołanie--> usude
    pad --"norma techniczna"--> en301549
    pad --delegacja--> wytyczne_pfron

    %% Powiązania Ustaw z Rozporządzeniami
    p_budowlane --> w_budynki
    p_budowlane --> w_metro
    p_telekomunikacyjne --> w_telekomunikacja
    k_wyborczy --> w_wybory

    %% Powiązania z normami
    eaa --"norma techniczna"--> en301549

